# ---------------------------------------------------------------------------
# Netlify liest diese Datei aus dem Publish-Verzeichnis.
# Sie gehoert also NEBEN die index.html, nicht in die Repo-Wurzel,
# falls die Seite in einem Unterordner liegt.
#
# Ersetzt die .htaccess-Hinweise aus HOCHLADEN.txt - die gelten nur fuer
# Apache-Server und werden von Netlify ignoriert.
# ---------------------------------------------------------------------------

# Alles unter assets/ bekommt eine lange Haltbarkeit. Wenn Sie eine dieser
# Dateien austauschen, geben Sie ihr einen neuen Namen (z. B. style-2.css),
# sonst sehen wiederkehrende Besucher monatelang die alte Fassung.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Die HTML-Dateien bleiben kurz gueltig, damit Textaenderungen rasch ankommen.
/*.html
  Cache-Control: public, max-age=600

/
  Cache-Control: public, max-age=600

# Grundlegende Absicherung
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
