# ---------------------------------------------------------------------------
# Netlify liest diese Datei aus dem Publish-Verzeichnis.
# Sie gehoert NEBEN die index.html, nicht in die Repo-Wurzel, falls die Seite
# in einem Unterordner liegt.
#
# Ersetzt die .htaccess-Hinweise aus HOCHLADEN.txt - die gelten nur fuer
# Apache und werden von Netlify ignoriert.
# ---------------------------------------------------------------------------

# WICHTIG - warum hier keine Jahres-Haltbarkeit mehr steht:
# Die Dateinamen dieser Seite tragen keine Versionsnummer. style.css heisst
# nach jeder Aenderung wieder style.css. Eine lange Haltbarkeit mit dem Zusatz
# "immutable" sagt dem Browser, er duerfe die Datei ein Jahr lang verwenden,
# ohne je nachzufragen - selbst beim normalen Neuladen. Nach einer Aenderung
# saehen wiederkehrende Besucher monatelang die alte Fassung.
#
# Eine Stunde ist der bessere Mittelweg: schnell genug fuer Aenderungen,
# sparsam genug fuer den Alltag. Netlify liefert ohnehin ueber ein Verteilnetz
# aus, der Geschwindigkeitsgewinn laengerer Fristen faellt kaum ins Gewicht.

/assets/*
  Cache-Control: public, max-age=3600, must-revalidate

# Videos aendern sich praktisch nie und sind gross - hier lohnt mehr Frist.
/assets/video/*
  Cache-Control: public, max-age=604800, must-revalidate

# HTML immer pruefen lassen, damit Textaenderungen sofort ankommen.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Grundlegende Absicherung
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
